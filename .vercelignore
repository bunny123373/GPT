# Dev-only files. Note: package.json and package-lock.json MUST stay —
# Vercel needs them to install dependencies and run the Next.js build.
.git
.gitignore
.vercel
node_modules
.next
.next-export
test
README.md
*.log

# Android / Capacitor. Never deployable and, worse, android/keystore holds the
# release signing key — uploading that anywhere it is not needed is a problem
# even for a private project.
android
release
capacitor.config.json
scripts