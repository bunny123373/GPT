{
  "name": "gpt",
  "version": "2.0.0",
  "private": true,
  "description": "GPT — streaming AI chat and image generation on Puter.js. Next.js App Router + Tailwind.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node test/run.js && node test/engine.js && node test/imagegen.js && node test/profile.js && node test/store.js && node test/gallery.js && node test/theme.js && node test/tokens.mjs && node test/assets.mjs",
    "test:unit": "npm run test",
    "test:image": "node test/imagegen.js",
    "test:gallery": "node test/gallery.js",
    "test:theme": "node test/theme.js && node test/tokens.mjs",
    "test:profile": "node test/profile.js",
    "test:css": "next build && node test/tailwind-audit.mjs",
    "test:sdk": "node test/sdk-surface.js"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": ["puter", "puter.js", "ai", "chat", "image-generation", "nextjs", "llm"],
  "license": "MIT"
}